{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedOrigins": [
    "http://localhost:4200"
  ],
  "Jwt": {
    //Who created the token
    "Issuer": "KdramasApp",
    //Which application the token is intended for
    "Audience": "KdramasApp.Api",
    //How long a token remains valid
    "AccessTokenMinutes": 15
  }
}
